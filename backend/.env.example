# ============ AWS Athena ============
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
ATHENA_WORKGROUP=tripo-analyst
ATHENA_OUTPUT_LOCATION=s3://tripo-telescope/data-agent/athena-results/

# ============ Claude API ============
# If using Anthropic directly:
CLAUDE_API_KEY=your-claude-api-key-here
CLAUDE_MODEL=claude-sonnet-4-6

# If using an API Router, uncomment and set:
# CLAUDE_BASE_URL=https://co.yes.vg/team

# ============ Cache ============
CACHE_DB_PATH=./cache/analysis_cache.db

# ============ Optional: PostgreSQL (Phase 3, pgvector) ============
# PG_ENABLED=false
# PG_CONNECTION_STRING=postgresql://user:pass@host:5432/db

# ============ Optional: Redis (Phase 3) ============
# REDIS_ENABLED=false
# REDIS_URL=redis://localhost:6379/0

# ============ Optional: Celery (Phase 3) ============
# CELERY_ENABLED=false
# CELERY_BROKER_URL=redis://localhost:6379/1
